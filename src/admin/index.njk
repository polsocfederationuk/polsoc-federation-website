---
# The local admin entry point.
#
# Emitted ONLY when CMS_DEV=1 — a normal build ignores src/admin/ entirely, so
# no /admin/ page reaches dist/ and therefore none can ever be deployed. See
# docs/CMS_FOUNDATION.md §2.
#
# Deliberately NOT using the shared site layout: the admin panel must not pull
# in the public navigation, the site stylesheet or js/main.js. It is a tool, not
# a page of the website.
permalink: /admin/index.html
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Belt and braces. This file is never deployed, but if it ever escaped it
         must not be indexed. -->
    <meta name="robots" content="noindex, nofollow, noarchive, noimageindex" />
    <title>Federation Content Manager</title>
    <style>
      /* The banner is the only styling here. Everything else is Decap's own. */
      .cms-local-banner {
        font: 600 13px/1.45 system-ui, -apple-system, "Segoe UI", sans-serif;
        background: #7a2020;
        color: #fff;
        padding: 8px 14px;
        margin: 0;
        text-align: center;
      }
      .cms-local-banner code {
        font-family: ui-monospace, "Cascadia Mono", Consolas, monospace;
        background: rgba(255, 255, 255, 0.16);
        padding: 1px 5px;
        border-radius: 3px;
      }
    </style>
  </head>
  <body>
    <p class="cms-local-banner">
      Local development only — edits are written straight to the files in your
      working copy. Nothing here is published. Review with
      <code>git diff</code> before committing.
    </p>

    <!--
      Decap CMS {{ cmsConfig.decapVersion }}, served from this directory rather than a CDN.

      The bundle is copied out of node_modules/decap-cms/dist/ by
      eleventy.config.js, so the exact version is the one pinned in
      package.json and frozen in package-lock.json. There is no `latest` URL to
      drift, and the panel works with no network connection.

      It reads ./config.yml on load and initialises itself; there is no init
      script here, and therefore no place for a credential to be typed.
    -->
    <script src="./decap-cms.js"></script>

    <!--
      DUPLICATE RECORD ID GUARD.

      Without this, typing an ID that already exists does not overwrite the other
      record — Decap writes `jane-example-1.yaml` instead — but it leaves
      `slug: jane-example` inside that file, so the filename and the slug
      disagree and `npm run validate` rejects the result. The editor gets no
      warning until then.

      This blocks the save instead, using two public interfaces and no private
      ones: `CMS.registerEventListener` with the documented `preSave` event, and
      the local proxy's own `entriesByFolder` action — the same request Decap
      itself makes to list a collection. `persistEntry` awaits the preSave
      handler as its first statement with no try/catch, so a handler that throws
      aborts the save and surfaces the message.

      Nothing here is patched, wrapped or replaced, so a Decap upgrade cannot
      silently change its behaviour: if `preSave` ever stopped firing the guard
      would simply stop running, and scripts/cms-check.js still catches the same
      collision from the command line.

      Local development only, exactly like the rest of this page.
    -->
    <script>
      (function () {
        "use strict";

        var PROXY = {{ cmsConfig.proxyUrl | dump | safe }};
        var BRANCH = {{ cmsConfig.guard.branch | dump | safe }};
        // Every folder collection whose filename is its own Record ID.
        var COLLECTIONS = {{ cmsConfig.guard.collections | dump | safe }};

        if (typeof window.CMS === "undefined") return;

        // The announcement link normaliser, embedded verbatim from
        // src/_data/cmsConfig.js so the browser runs the same function
        // scripts/test-announcement-rules.js exercises.
        {{ cmsConfig.normaliseLinkSource | safe }}

        /** The entry's own file path, or "" for a record being created. */
        function pathOf(entry) {
          if (!entry) return "";
          if (typeof entry.get === "function") return entry.get("path") || "";
          return entry.path || "";
        }

        /** Field values, whether Decap hands over an Immutable map or a plain object. */
        function dataOf(entry) {
          if (!entry) return {};
          if (typeof entry.getIn === "function") {
            var d = entry.get("data");
            return d && typeof d.toJS === "function" ? d.toJS() : d || {};
          }
          return entry.data || {};
        }

        /** Ask the proxy which files a collection's folder currently holds. */
        function existingPaths(collection) {
          return fetch(PROXY, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              action: "entriesByFolder",
              params: {
                branch: BRANCH,
                folder: collection.folder,
                extension: collection.extension,
                depth: 1,
              },
            }),
          })
            .then(function (r) { return r.ok ? r.json() : []; })
            .then(function (entries) {
              return (entries || []).map(function (e) {
                return e && e.file && e.file.path;
              }).filter(Boolean);
            })
            // A guard that cannot reach the proxy must not block legitimate work.
            // scripts/cms-check.js is the backstop.
            .catch(function () { return null; });
        }

        window.CMS.registerEventListener({
          name: "preSave",
          handler: function (props) {
            var entry = props && props.entry;
            var data = dataOf(entry);
            var slug = data && data.slug;
            var ownPath = pathOf(entry);

            /*
              LINK NORMALISATION.

              Decap's object widget remembers every sub-field it has ever held,
              so an editor who picks a Federation event and then switches to an
              external address leaves the slug behind — and there is no reliable
              clear control to remove it by hand. Reducing the link to exactly
              one destination here is what makes the destination reversible.

              The handler's return value becomes the entry's data (see
              persistEntry -> invokePreSaveEvent), so returning the corrected
              data is the documented way to do this. The value is returned
              synchronously below only when nothing else needs checking;
              otherwise it is carried through the duplicate-ID promise.
            */
            var normalisedData = null;
            if (entry && typeof entry.get === "function" && ("link" in data)) {
              var current = data.link;
              var cleaned = normaliseAnnouncementLink(
                current && typeof current.toJS === "function" ? current.toJS() : current
              );
              if (JSON.stringify(cleaned) !== JSON.stringify(
                current && typeof current.toJS === "function" ? current.toJS() : current
              )) {
                normalisedData = entry.get("data").set("link", cleaned);
              }
            }

            // Which collection is this? Site settings is a file collection with
            // a fixed path and no Record ID, so it is simply not matched.
            if (!slug || typeof slug !== "string") return normalisedData || undefined;

            var collection = null;
            for (var i = 0; i < COLLECTIONS.length; i++) {
              if (ownPath && ownPath.indexOf(COLLECTIONS[i].folder + "/") === 0) {
                collection = COLLECTIONS[i];
                break;
              }
            }
            // A record being created has no path yet. Checking every folder is
            // correct rather than lazy: an ID must be unique within its own
            // collection, and testing them all costs one request each.
            var candidates = collection ? [collection] : COLLECTIONS;

            for (var j = 0; j < candidates.length; j++) {
              if (!new RegExp(candidates[j].pattern).test(slug)) {
                throw new Error(
                  'Record ID "' + slug + '" is not valid. Use lowercase letters, ' +
                  "numbers and single hyphens only — for example spring-careers-evening."
                );
              }
            }

            return Promise.all(candidates.map(function (c) {
              return existingPaths(c).then(function (paths) {
                if (paths === null) return null;              // proxy unreachable
                var target = c.folder + "/" + slug + "." + c.extension;
                if (paths.indexOf(target) === -1) return null; // no such record
                if (ownPath === target) return null;           // editing that record
                return { collection: c, target: target };
              });
            })).then(function (hits) {
              var clash = hits.filter(Boolean)[0];
              if (clash) {
                throw new Error(
                  "A " + clash.collection.label + " with this ID already exists (" +
                  clash.target + "). Use a different Record ID — for example " +
                  slug + "-2026-27 for another academic year. " +
                  "The existing record has not been changed."
                );
              }
              // Undefined leaves the data untouched; anything else replaces it.
              return normalisedData || undefined;
            });
          },
        });
      })();
    </script>
  </body>
</html>
