          <th scope="row" data-label="Purpose/Use">Take payment and reimburse travel and expenses</th>
          <td data-label="Type of data"><ol type="a"><li>Identity</li><li>Contact</li><li>Financial</li><li>Transaction</li></ol></td>
          <td data-label="Legal basis"><ol type="a"><li>Performance of a contract with you</li><li>Necessary to comply with a legal obligation (to keep accounting records)</li></ol></td>
        </tr>
