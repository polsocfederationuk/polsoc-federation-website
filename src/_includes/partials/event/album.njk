{#
  The photo-album card.

  The album URL is shared; the heading, description and button label are
  localised. The camera glyph is decorative and aria-hidden, as on the live page.
#}
{#-
  Rendered only when an album is actually configured. The old architecture gated
  this with an "album" marker in the section list; the template owns the position
  now, so the guard belongs here.
-#}
{%- if event.album_url and c.album and c.album.heading %}
    <div class="album-card reveal">
      <div class="cam" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
      </div>
      <div class="album-info">
        <h3>{{ c.album.heading }}</h3>
        <p>{{ c.album.text }}</p>
      </div>
      <a class="btn btn-primary" href="{{ event.album_url }}" target="_blank" rel="noopener">{{ c.album.label }} <span class="arrow">&rarr;</span></a>
    </div>
{%- endif %}
