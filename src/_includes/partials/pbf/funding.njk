{#
  Funding acknowledgement.

  Deliberately part of the Business Forum extension and nothing else: it exists
  because this edition is co-financed by the Senate of the Republic of Poland, and
  the wording is a condition of that funding. Generalising it into every event
  would invite an empty acknowledgement on events that have no funder.
#}
    <div class="funding-note reveal">
      <img src="{{ bf.funding_acknowledgement.logo }}" alt="{{ bf.funding_acknowledgement.logo_alt[locale.code] }}">
      <p>{{ bf.funding_acknowledgement.text[locale.code] }}</p>
    </div>
