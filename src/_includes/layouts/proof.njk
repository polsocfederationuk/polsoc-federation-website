{#
  Phase 2 proof layout — deliberately minimal, deliberately NOT the site chrome.

  This is the original Phase 2 shell, kept unchanged so the Phase 2 proof page
  (dist/build-test/index.html) still demonstrates exactly what it demonstrated
  before: layout + partial + bilingual record + root-relative assets, with no
  site styling to distract from it.

  Phase 3's chrome comparison page uses layouts/base.njk instead, which renders
  the real header, navigation, language switcher and footer.
#}<!DOCTYPE html>
<html lang="{{ locale.htmlLang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">

  <meta name="robots" content="noindex, nofollow">

  <link rel="canonical" href="{{ site.domain }}{{ urlPattern | urlFor(locale) }}">
  {%- for l in locales %}
  <link rel="alternate" hreflang="{{ l.code }}" href="{{ site.domain }}{{ urlPattern | urlFor(l) }}">
  {%- endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ site.domain }}{{ urlPattern | urlFor(locales[0]) }}">

  <meta property="og:type" content="website">
  <meta property="og:locale" content="{{ locale.ogLocale }}">
  {%- for l in locales %}{% if l.code != locale.code %}
  <meta property="og:locale:alternate" content="{{ l.ogLocale }}">
  {%- endif %}{% endfor %}
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ site.domain }}{{ urlPattern | urlFor(locale) }}">
  <meta property="og:image" content="{{ site.domain }}{{ site.logo | asset }}">

  <link rel="icon" href="{{ '/favicon.ico' | asset }}" sizes="any">

  <style>
    body { font-family: system-ui, sans-serif; max-width: 46rem; margin: 2rem auto; padding: 0 1rem; line-height: 1.6; }
    code { background: #f4f4f4; padding: 0.1em 0.35em; border-radius: 3px; }
    table { border-collapse: collapse; width: 100%; }
    td, th { border: 1px solid #ddd; padding: 0.4rem 0.6rem; text-align: left; font-size: 0.95rem; }
  </style>
</head>
<body>

{% include "partials/test-banner.njk" %}

<main>
{{ content | safe }}
</main>

{% include "partials/build-footer.njk" %}

</body>
</html>
