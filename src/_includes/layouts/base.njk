{#
  Shared base layout — ARCHITECTURAL PROOF ONLY (Phase 2).

  This deliberately does NOT reproduce the live site's chrome. Its job is to
  prove that one layout can serve both languages: `lang`, `og:locale` and the
  hreflang pair are all derived from the `locale` object supplied by pagination,
  not hard-coded per page.

  When the public pages migrate, this file grows into the real base layout and
  the partials below are replaced with the site's real header/nav/footer.
#}<!DOCTYPE html>
<html lang="{{ locale.htmlLang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">

  {# Test pages must never be indexed, even if dist/ is ever served by accident. #}
  <meta name="robots" content="noindex, nofollow">

  {# --- SEO/hreflang generation, driven entirely by data -------------------
     Every URL below derives from the single `urlPattern` the page declares.
     The canonical is always self-referencing; the alternates are identical on
     both pages of a pair; x-default always points at English (locales[0]).
     This is the rule the public pages already follow by hand. #}
  <link rel="canonical" href="{{ site.domain }}{{ urlPattern | urlFor(locale) }}">
  {%- for l in locales %}
  <link rel="alternate" hreflang="{{ l.code }}" href="{{ site.domain }}{{ urlPattern | urlFor(l) }}">
  {%- endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ site.domain }}{{ urlPattern | urlFor(locales[0]) }}">

  <meta property="og:type" content="website">
  <meta property="og:locale" content="{{ locale.ogLocale }}">
  {%- for l in locales %}{% if l.code != locale.code %}
  <meta property="og:locale:alternate" content="{{ l.ogLocale }}">
  {%- endif %}{% endfor %}
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ site.domain }}{{ urlPattern | urlFor(locale) }}">
  <meta property="og:image" content="{{ site.domain }}{{ site.logo | asset }}">

  {# Root-relative, and therefore identical on the English page (depth 0) and
     the Polish page (depth 1). This is the property that matters. #}
  <link rel="icon" href="{{ '/favicon.ico' | asset }}" sizes="any">

  <style>
    /* Intentionally minimal. The proof pages must not look like the live site,
       so nobody mistakes them for a redesign. */
    body { font-family: system-ui, sans-serif; max-width: 46rem; margin: 2rem auto; padding: 0 1rem; line-height: 1.6; }
    code { background: #f4f4f4; padding: 0.1em 0.35em; border-radius: 3px; }
    table { border-collapse: collapse; width: 100%; }
    td, th { border: 1px solid #ddd; padding: 0.4rem 0.6rem; text-align: left; font-size: 0.95rem; }
  </style>
</head>
<body>

{% include "partials/test-banner.njk" %}

<main>
{{ content | safe }}
</main>

{% include "partials/build-footer.njk" %}

</body>
</html>
