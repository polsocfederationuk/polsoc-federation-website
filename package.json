{
  "name": "polsoc-federation-website",
  "version": "1.0.0",
  "private": true,
  "description": "Static bilingual website for the Federation of Polish Student Societies in the UK. The live site is still the hand-written HTML at the repository root; the Eleventy build under src/ + content/ currently generates only architectural proof pages into dist/. See docs/BUILD_ARCHITECTURE.md.",
  "scripts": {
    "build": "eleventy",
    "clean": "node scripts/clean.js",
    "validate": "node scripts/validate.js",
    "compare:chrome": "node scripts/compare-chrome.js",
    "compare:team": "node scripts/compare-team.js",
    "serve": "python -m http.server 8000",
    "serve:dist": "python -m http.server 8001 --directory dist",
    "compare:announcements": "node scripts/compare-announcements.js",
    "compare:members": "node scripts/compare-members.js",
    "compare:contact": "node scripts/compare-contact.js",
    "compare:404": "node scripts/compare-404.js",
    "audit:events": "node scripts/audit-events.js",
    "compare:events-standard": "node scripts/compare-standard-events.js",
    "compare:business-forum": "node scripts/compare-business-forum.js",
    "test:event-groups": "node scripts/test-event-listing-groups.js",
    "compare:events-listing": "node scripts/compare-events-listing.js",
    "compare:homepage": "node scripts/compare-homepage.js",
    "build:fixtures": "node scripts/build-fixtures.js",
    "test:archive-ui": "node scripts/test-archive-ui.js",
    "audit:dist": "node scripts/audit-dist.js",
    "crawl:dist": "node scripts/crawl-dist.js",
    "audit:public-parity": "node scripts/audit-public-parity.js",
    "compare:sitemap": "node scripts/compare-sitemap.js",
    "build:cms": "node scripts/build-cms.js",
    "cms:proxy": "node scripts/cms-proxy.js",
    "cms:serve": "node scripts/cms-server.js",
    "validate:cms": "node scripts/validate-cms.js",
    "cms:check": "node scripts/cms-check.js",
    "test:cms-roundtrip": "node scripts/test-cms-roundtrip.js",
    "test:team-rules": "node scripts/test-team-rules.js",
    "test:announcement-rules": "node scripts/test-announcement-rules.js",
    "test:event-rules": "node scripts/test-event-rules.js",
    "test:event-content": "node scripts/test-event-content.js",
    "test:bulk": "node scripts/test-bulk.js",
    "cms:dev": "node scripts/cms-dev.js",
    "cms:smoke": "node scripts/cms-smoke.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "decap-cms": "3.15.1",
    "decap-server": "3.10.0",
    "js-yaml": "^4.3.0",
    "markdown-it": "^14.3.0"
  }
}
