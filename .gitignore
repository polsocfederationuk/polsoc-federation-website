.claude/
.DS_Store
Thumbs.db

# Build tooling (Phase 2). Development-only: nothing here is served to
# visitors, and Netlify still publishes the repository root.
node_modules/

# Generated output — NEVER edit these files by hand, and never commit them.
# Everything in dist/ is produced by `npm run build` and discarded by
# `npm run clean`. The source of truth is src/ and content/.
dist/

# Eleventy caches
.cache/
.eleventy.cache/

# Architectural fixtures (Phase 15). Built by `npm run build:fixtures` into a
# separate tree so a normal build — and therefore the deployment tree — can never
# contain a test page. Development-only, exactly like dist/.
.fixtures/

# Local CMS development runtime (Phase 17C.2). Built by `npm run cms:dev` into a
# tree of its own so that public build commands — clean, build, validate:cms —
# cannot delete the files backing a CMS session an editor has open. Generated
# output only; the CMS SOURCE lives in src/admin/ and src/_data/cmsConfig.js and
# stays tracked.
.cms/
